# Copy to .env and adjust. Never commit the real .env.
# Docker Compose reads this file automatically; the backend reads the same names from the environment.

# --- Database (backend) ---------------------------------------------------------
# JDBC URL. With Docker Compose the backend uses the `postgres` service automatically.
DATABASE_URL=jdbc:postgresql://localhost:5435/eloria
DATABASE_USERNAME=eloria
DATABASE_PASSWORD=change-me

# Docker Compose PostgreSQL container (must match the credentials above)
POSTGRES_DB=eloria
POSTGRES_USER=eloria
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL
POSTGRES_PORT=5435

# --- Security -------------------------------------------------------------------
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Required in production.
JWT_SECRET=
# Token lifetime (Spring duration: 12h, 30m, PT12H…)
JWT_EXPIRATION=12h

# First administrator, created at startup if the account does not exist yet (production).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Spring profile ----------------------------------------------------------------
# dev = demo data + verbose logging, prod = no demo data, secrets required
SPRING_PROFILES_ACTIVE=dev
# Expose Swagger UI in production (dev always exposes it)
SWAGGER_ENABLED=false

# --- Images -------------------------------------------------------------------------
# Storage provider (local today; cloudinary / s3 / r2 implementations plug in here)
STORAGE_TYPE=local
# Where uploaded images are written (local storage provider)
UPLOAD_DIRECTORY=./uploads
# URL prefix the uploads are served from: /uploads behind the proxy, or an absolute API/CDN URL
UPLOAD_PUBLIC_BASE_URL=/uploads
UPLOAD_MAX_FILE_SIZE=8MB

# --- Web --------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5174
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8088

# --- Frontend (Vite, read at build time) ------------------------------------------------
# /api when the frontend and API share an origin (Vite proxy, Nginx); otherwise the API's absolute URL
VITE_API_URL=/api
